# analysis/.gitignore (in addition to repo-root .gitignore)

# Local data + derived outputs (never commit recordings or generated artifacts)
data/
derived/
figures/

# uv / venv
.venv/

# Build / cache
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Notebook checkpoints
.ipynb_checkpoints/

# Submodule contents are tracked via .gitmodules + commit SHA; the working
# tree is populated by `git submodule update --init`. Ignore stray local files.
external/imu_gait_analysis/.venv/
external/imu_gait_analysis/**/__pycache__/
external/imu_gait_analysis/**/*.pyc
